DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adopetz
PORT=3000
SESSION_SECRET=adopetz_secret_2026

# Otimizacoes (Medicao 2)
# Conexoes do pool MySQL por processo. Varredura: 5, 10 (original), 25, 50 e 100.
# Com cluster, o total e CLUSTER_WORKERS x DB_POOL_SIZE e precisa caber em max_connections do MySQL.
DB_POOL_SIZE=10
# Processos Node (cluster). 1 = sem cluster (original).
CLUSTER_WORKERS=1
# 1 = abre todas as conexoes do pool ao subir o servidor. 0 = sob demanda (original).
DB_PREWARM=1
# 1 = prepared statements (pool.execute) no login e no cadastro. 0 = pool.query (original).
DB_USE_EXECUTE=1
